{
  "name": "@mvarble/mkdoc",
  "version": "0.0.7",
  "description": "Build a standalone webpage out of a single markdown or mdsvex document.",
  "license": "MIT",
  "author": "Matthew Varble <matthew@rodent.club>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvarble/mkdoc.git"
  },
  "homepage": "https://github.com/mvarble/mkdoc#readme",
  "bugs": {
    "url": "https://github.com/mvarble/mkdoc/issues"
  },
  "keywords": [
    "markdown",
    "mdsvex",
    "svelte",
    "katex",
    "static-site",
    "cli",
    "vite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "mkdoc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=22"
  },
  "mkdoc": {
    "modules": [
      "three"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "example": "node dist/cli.js dev example/measures.md",
    "example:scene": "node dist/cli.js dev example/scene.svx",
    "format": "prettier --write .",
    "lint": "prettier --check . && tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@mvarble/mesearch-markdown": "^0.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "js-yaml": "^4.1.0",
    "katex": "^0.18.4",
    "svelte": "^5.56.1",
    "three": "^0.185.1",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3"
  }
}
